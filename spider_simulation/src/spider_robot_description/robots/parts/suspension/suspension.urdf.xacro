<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find spider_robot_description)/robots/parts/suspension/suspension.gazebo.xacro"/>

  <!--
    Spider flipper arm. On this robot the flipper is not decoration: it is the
    track frame, and it carries the two wheels its track runs around (see
    wheel.urdf.xacro). Rotating the joint swings the outer wheel up, which is
    what lets the vehicle climb.

    Two mirrored meshes are supplied (FL/RR share one, FR/RL the other) and the
    inertial and collision offsets flip sign with them, so both are derived
    from the mesh name rather than passed separately.
  -->
  <xacro:property name="flipper_stl_1" value="Flipper_FL_RR_bin.STL"/>
  <xacro:property name="flipper_stl_2" value="Flipper_FR_RL_bin.STL"/>

  <xacro:macro name="flipper_v0" params="prefix parent stl *joint_origin *joint_axis">
	<joint name="${prefix}_flipper_joint" type="revolute">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="${prefix}_flipper_link"/>
	  <xacro:insert_block name="joint_axis"/>
	  <dynamics damping="0.001" friction="0.0001"/>
	  <!--
	    The source description declares these joints "continuous" yet gives them
	    limits, which URDF ignores on a continuous joint. Declaring them
	    revolute makes the limits real, which the gz JointPositionController
	    and the driver's own clamp both rely on. 1.46 rad = 83.6 deg.
	  -->
	  <limit effort="100" velocity="1.5708" lower="-1.46" upper="1.46"/>
	</joint>

	<link name="${prefix}_flipper_link">
	  <visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
		  <mesh filename="package://spider_robot_description/meshes/STL/spider/${stl}"
		        scale="0.001 0.001 0.001"/>
		</geometry>
		<material name="spider_black"/>
	  </visual>
	  <collision>
		<xacro:if value="${stl == flipper_stl_1}">
		  <origin xyz="0.119 0.021 0.035" rpy="0 0 0"/>
		</xacro:if>
		<xacro:unless value="${stl == flipper_stl_1}">
		  <origin xyz="0.119 -0.021 0.034" rpy="0 0 0"/>
		</xacro:unless>
		<geometry>
		  <box size="0.316 0.091 0.146"/>
		</geometry>
	  </collision>
	  <inertial>
		<xacro:if value="${stl == flipper_stl_1}">
		  <origin xyz="0.123 0.033 0.029" rpy="0 0 0"/>
		</xacro:if>
		<xacro:unless value="${stl == flipper_stl_1}">
		  <origin xyz="0.123 -0.033 0.029" rpy="0 0 0"/>
		</xacro:unless>
		<mass value="0.322"/>
		<inertia ixx="0.001119686" ixy="0.0001239386" ixz="0.0001140656"
		         iyy="0.008247686" iyz="0.000378888" izz="0.007985380"/>
	  </inertial>
	</link>
  </xacro:macro>

</robot>
