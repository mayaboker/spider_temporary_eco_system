<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find spider_robot_description)/robots/parts/base/base.gazebo.xacro"/>

  <!--
    Spider chassis. The caller supplies the 0.1346 m lift from base_footprint
    that the source description expressed as a separate base_link -> body_link
    joint; folding it into this joint keeps the link names the driver and
    DiffDrive expect.

    Unlike the earlier version of this base, the link carries no track
    visuals: the tracks are the flipper arms themselves, so the drive geometry
    lives entirely in the flipper and wheel macros.
  -->
  <xacro:macro name="base_v0" params="parent *joint_origin">
	<joint name="base_link_joint" type="fixed">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="base_link"/>
	</joint>

	<link name="base_link">
	  <visual>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
		  <mesh filename="package://spider_robot_description/meshes/STL/spider/Body_bin.STL"
		        scale="0.001 0.001 0.001"/>
		</geometry>
		<material name="spider_gray"/>
	  </visual>
	  <collision>
		<origin xyz="0 0 0" rpy="0 0 0"/>
		<geometry>
		  <!-- Primitive collision; DART cannot build a shape from the mesh. -->
		  <box size="0.293 0.190 0.073"/>
		</geometry>
	  </collision>
	  <inertial>
		<origin xyz="0 0 0.003" rpy="0 0 0"/>
		<mass value="0.843"/>
		<inertia ixx="0.004376981" ixy="0" ixz="0"
		         iyy="0.010878840" iyz="0" izz="0.014340315"/>
	  </inertial>
	</link>
  </xacro:macro>

</robot>
