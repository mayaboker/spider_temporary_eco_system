<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find spider_robot_description)/robots/parts/base/base.gazebo.xacro"/>

  <xacro:macro name="main_track_visual" params="side">
	<!-- Fixed visible track; hidden wheel contacts supply its motion. -->
	<visual>
	  <origin xyz="0 ${side * 0.052} -0.010"/>
	  <geometry>
		<box size="0.145 0.030 0.047"/>
	  </geometry>
	  <material name="track_rubber"/>
	</visual>
	<visual>
	  <origin xyz="0 ${side * 0.052} -0.010"/>
	  <geometry>
		<box size="0.108 0.033 0.027"/>
	  </geometry>
	  <material name="spider_orange"/>
	</visual>
	<visual>
	  <origin xyz="0.050 ${side * 0.052} -0.010" rpy="1.57079632679 0 0"/>
	  <geometry>
		<cylinder radius="0.017" length="0.035"/>
	  </geometry>
	  <material name="roller_metal"/>
	</visual>
	<visual>
	  <origin xyz="-0.050 ${side * 0.052} -0.010" rpy="1.57079632679 0 0"/>
	  <geometry>
		<cylinder radius="0.017" length="0.035"/>
	  </geometry>
	  <material name="roller_metal"/>
	</visual>
  </xacro:macro>
  
  <xacro:macro name="base_v0" params="parent *joint_origin">
	<joint name="base_link_joint" type="fixed">
	  <xacro:insert_block name="joint_origin"/>
	  <parent link="${parent}"/>
	  <child link="base_link"/>
	</joint>

	<link name="base_link">
	  <visual>
		<geometry>
		  <mesh filename="package://spider_robot_description/meshes/DAE/base/base_link.dae"/>
		</geometry>
	  </visual>
	  <xacro:main_track_visual side="1"/>
	  <xacro:main_track_visual side="-1"/>
	  <collision>
		<origin xyz="0 0 0.017"/>
		<geometry>
		  <!-- DART cannot create collision shapes from the original STL. -->
		  <box size="0.19 0.09 0.034"/>
		</geometry>
	  </collision>
	  <inertial>
		<origin xyz="0 0 0.017"/>
		<mass value="1.2"/>
		<inertia ixx="0.0001873" ixy="0" ixz="0" iyy="0.000055" iyz="0" izz="0.0002283" />
	  </inertial>
	</link>
  </xacro:macro>
  
</robot>
