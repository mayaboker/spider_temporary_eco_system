<?xml version="1.0"?>
<!-- Basic differential drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spider_robot">
  
  <xacro:include filename="$(find spider_robot_description)/gazebo/spider_robot.gazebo.xacro" />
  <xacro:include filename="$(find spider_robot_description)/robots/parts/base/base.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/suspension/suspension.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/wheel/wheel.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/lidar_base/lidar_base.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/lidar_head/lidar_head.urdf.xacro"/>
  <xacro:property name="M_PI" value="3.14159274"/>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="track_rubber">
    <color rgba="0.035 0.045 0.055 1.0"/>
  </material>
  <material name="spider_orange">
    <color rgba="0.95 0.32 0.04 1.0"/>
  </material>
  <material name="roller_metal">
    <color rgba="0.30 0.34 0.38 1.0"/>
  </material>

  <!-- =============== Link & Joint =============== -->
  <!-- Base -->
  <link name="base_footprint"/> <!--link name="base_footprint"/ -->
  <xacro:base_v0 parent="base_footprint"> <!-- xacro:base_v0 parent="base_footprint" -->
	<origin xyz="0 0 0"/>
  </xacro:base_v0>

  <!-- lidar_base -->
  <xacro:lidar_base_v0 parent="base_link">
	<origin xyz="-0.022 0 0.035"/>
  </xacro:lidar_base_v0>

  <!-- lidar_head -->
  <xacro:lidar_head_v0 parent="base_link">
	<origin xyz="0.0 0 0.035"/>
  </xacro:lidar_head_v0>

  <!-- Articulated tracked flippers -->
  <!-- Front right flipper -->
  <xacro:flipper_v0 prefix="fr" parent="base_link" direction="1" side="-1">
	<origin xyz="0.077 -0.031 -0.004"/>
	<axis xyz="0 -1 0"/>
  </xacro:flipper_v0>
  <!-- Front left flipper -->
  <xacro:flipper_v0 prefix="fl" parent="base_link" direction="1" side="1">
	<origin xyz="0.077 0.031 -0.004"/>
	<axis xyz="0 -1 0"/>
  </xacro:flipper_v0>
  <!-- Rear right flipper -->
  <xacro:flipper_v0 prefix="rr" parent="base_link" direction="-1" side="-1">
	<origin xyz="-0.077 -0.031 -0.004"/>
	<axis xyz="0 1 0"/>
  </xacro:flipper_v0>
  <!-- Rear left flipper -->
  <xacro:flipper_v0 prefix="rl" parent="base_link" direction="-1" side="1">
	<origin xyz="-0.077 0.031 -0.004"/>
	<axis xyz="0 1 0"/>
  </xacro:flipper_v0>

  <!-- Wheel -->
  <!-- Front Right Wheel -->
  <xacro:wheel_v0 prefix="fr" parent="base_link">
	<origin xyz="0.077 -0.052 -0.029"/>
	<axis xyz="0 1 0"/>
  </xacro:wheel_v0>
  <!--  Front Left Wheel -->
  <xacro:wheel_v0 prefix="fl" parent="base_link">
	<origin xyz="0.077 0.052 -0.029" rpy="0 0 ${M_PI}"/>
	<axis xyz="0 -1 0"/>
  </xacro:wheel_v0>
  <!-- Rear Right Wheel -->
  <xacro:wheel_v0 prefix="rr" parent="base_link">
	<origin xyz="-0.077 -0.052 -0.029"/>
	<axis xyz="0 1 0"/>
  </xacro:wheel_v0>
  <!--  Rear Left Wheel -->
  <xacro:wheel_v0 prefix="rl" parent="base_link">
	<origin xyz="-0.077 0.052 -0.029" rpy="0 0 ${M_PI}"/>
	<axis xyz="0 -1 0"/>
  </xacro:wheel_v0>

  <!-- =============== Gazebo =============== -->

  <!-- Base -->
  <xacro:base_gazebo_v0/>

  <!-- lidar base -->
  <xacro:lidar_base_gazebo_v0/>

  <!-- lidar head -->
  <xacro:lidar_head_gazebo_v0/>

  <!-- Wheel -->
  <xacro:wheel_gazebo_v0 prefix="fr"/>
  <xacro:wheel_gazebo_v0 prefix="fl"/>
  <xacro:wheel_gazebo_v0 prefix="rr"/>
  <xacro:wheel_gazebo_v0 prefix="rl"/>

  <!-- Flippers -->
  <xacro:flipper_gazebo_v0 prefix="fr"/>
  <xacro:flipper_gazebo_v0 prefix="fl"/>
  <xacro:flipper_gazebo_v0 prefix="rr"/>
  <xacro:flipper_gazebo_v0 prefix="rl"/>

  <xacro:spider_robot_gazebo/>
    
</robot>
