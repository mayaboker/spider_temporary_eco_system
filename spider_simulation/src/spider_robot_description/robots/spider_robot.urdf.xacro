<?xml version="1.0"?>
<!-- Spider: tracked chassis on four independently articulated track arms -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="spider_robot">

  <xacro:include filename="$(find spider_robot_description)/gazebo/spider_robot.gazebo.xacro" />
  <xacro:include filename="$(find spider_robot_description)/robots/parts/base/base.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/suspension/suspension.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/wheel/wheel.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/lidar_base/lidar_base.urdf.xacro"/>
  <xacro:include filename="$(find spider_robot_description)/robots/parts/lidar_head/lidar_head.urdf.xacro"/>
  <xacro:property name="M_PI" value="3.14159274"/>

  <material name="spider_gray">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>
  <material name="spider_black">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <!-- =============== Link & Joint =============== -->
  <!--
    Base. The source description lifts the chassis 0.1346 m over the
    ground-level root through a separate body_link; that offset is folded into
    base_link_joint here so the link names stay the ones DiffDrive and the
    Teensy bridge already use.
  -->
  <link name="base_footprint"/>
  <xacro:base_v0 parent="base_footprint">
	<origin xyz="0 0 0.1346"/>
  </xacro:base_v0>

  <!-- lidar_base: 0.0365 clears the top face of the 0.073 m chassis -->
  <xacro:lidar_base_v0 parent="base_link">
	<origin xyz="-0.022 0 0.037"/>
  </xacro:lidar_base_v0>

  <!-- lidar_head -->
  <xacro:lidar_head_v0 parent="base_link">
	<origin xyz="0.0 0 0.037"/>
  </xacro:lidar_head_v0>

  <!--
    Track arms. The rear pair is yawed by pi so the arm extends rearwards; that
    is also why its joint axis is negated, keeping a positive command "arm up"
    on all four corners.
  -->
  <xacro:flipper_v0 prefix="fl" parent="base_link" stl="${flipper_stl_1}">
	<origin xyz="0.115 0.0755 -0.005" rpy="0 0 0"/>
	<axis xyz="0 1 0"/>
  </xacro:flipper_v0>
  <xacro:flipper_v0 prefix="fr" parent="base_link" stl="${flipper_stl_2}">
	<origin xyz="0.115 -0.0755 -0.005" rpy="0 0 0"/>
	<axis xyz="0 1 0"/>
  </xacro:flipper_v0>
  <xacro:flipper_v0 prefix="rl" parent="base_link" stl="${flipper_stl_2}">
	<origin xyz="-0.115 0.0755 -0.005" rpy="0 0 ${M_PI}"/>
	<axis xyz="0 -1 0"/>
  </xacro:flipper_v0>
  <xacro:flipper_v0 prefix="rr" parent="base_link" stl="${flipper_stl_1}">
	<origin xyz="-0.115 -0.0755 -0.005" rpy="0 0 ${M_PI}"/>
	<axis xyz="0 -1 0"/>
  </xacro:flipper_v0>

  <!--
    Track wheels, two per flipper. The inner one sits on the arm's pivot axis
    (x=0) and keeps the unsuffixed joint name; the outer one rides at x=0.24.
    The rear joints carry a second yaw of pi which cancels the arm's own, so
    every track wheel still spins about body +y.
  -->
  <xacro:wheel_v0 prefix="fl" parent="fl_flipper_link" stl="${wheel_stl_l}">
	<origin xyz="0 0.06 0" rpy="0 0 0"/>
  </xacro:wheel_v0>
  <xacro:wheel_v0 prefix="fl" parent="fl_flipper_link" stl="${wheel_stl_l}" suffix="_2">
	<origin xyz="0.24 0.06 0" rpy="0 0 0"/>
  </xacro:wheel_v0>

  <xacro:wheel_v0 prefix="fr" parent="fr_flipper_link" stl="${wheel_stl_r}">
	<origin xyz="0 -0.06 0" rpy="0 0 0"/>
  </xacro:wheel_v0>
  <xacro:wheel_v0 prefix="fr" parent="fr_flipper_link" stl="${wheel_stl_r}" suffix="_2">
	<origin xyz="0.24 -0.06 0" rpy="0 0 0"/>
  </xacro:wheel_v0>

  <xacro:wheel_v0 prefix="rl" parent="rl_flipper_link" stl="${wheel_stl_l}">
	<origin xyz="0 -0.06 0" rpy="0 0 ${M_PI}"/>
  </xacro:wheel_v0>
  <xacro:wheel_v0 prefix="rl" parent="rl_flipper_link" stl="${wheel_stl_l}" suffix="_2">
	<origin xyz="0.24 -0.06 0" rpy="0 0 ${M_PI}"/>
  </xacro:wheel_v0>

  <xacro:wheel_v0 prefix="rr" parent="rr_flipper_link" stl="${wheel_stl_r}">
	<origin xyz="0 0.06 0" rpy="0 0 ${M_PI}"/>
  </xacro:wheel_v0>
  <xacro:wheel_v0 prefix="rr" parent="rr_flipper_link" stl="${wheel_stl_r}" suffix="_2">
	<origin xyz="0.24 0.06 0" rpy="0 0 ${M_PI}"/>
  </xacro:wheel_v0>

  <!-- =============== Gazebo =============== -->

  <xacro:base_gazebo_v0/>
  <xacro:lidar_base_gazebo_v0/>
  <xacro:lidar_head_gazebo_v0/>

  <xacro:wheel_gazebo_v0 prefix="fl"/>
  <xacro:wheel_gazebo_v0 prefix="fr"/>
  <xacro:wheel_gazebo_v0 prefix="rl"/>
  <xacro:wheel_gazebo_v0 prefix="rr"/>
  <xacro:wheel_gazebo_v0 prefix="fl" suffix="_2"/>
  <xacro:wheel_gazebo_v0 prefix="fr" suffix="_2"/>
  <xacro:wheel_gazebo_v0 prefix="rl" suffix="_2"/>
  <xacro:wheel_gazebo_v0 prefix="rr" suffix="_2"/>

  <xacro:flipper_gazebo_v0 prefix="fl"/>
  <xacro:flipper_gazebo_v0 prefix="fr"/>
  <xacro:flipper_gazebo_v0 prefix="rl"/>
  <xacro:flipper_gazebo_v0 prefix="rr"/>

  <xacro:spider_robot_gazebo/>

</robot>
